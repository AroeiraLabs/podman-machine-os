--- a/podman-image/Containerfile.COREOS
+++ b/podman-image/Containerfile.COREOS
@@ -4,7 +4,14 @@
 # format matches (fedora:latest can emit a newer policydb than FCOS semodule accepts).
 FROM ${FCOS_BASE_IMAGE} AS qemu_guest_agent_vsock_selinux
 COPY qemu_guest_agent_vsock.te /qemu_guest_agent_vsock.te
-RUN dnf install -y checkpolicy policycoreutils && dnf clean all && \
+RUN rm -f /etc/yum.repos.d/*.repo && \
+    printf '%s\n' '[acai-f44-ga-locked]' 'name=Fedora 44 GA (locked)' \
+      'baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/aarch64/os/' \
+      'enabled=1' 'gpgcheck=1' 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary' \
+      'metadata_expire=never' > /etc/yum.repos.d/acai-f44-ga-locked.repo && \
+    dnf makecache --refresh && \
+    echo "ad124f8125666e9059d7a8180427bdaea80f6286f71140457e5c7edd95883eee  $(find /var/cache -path '*acai-f44-ga-locked*' -name repomd.xml | head -1)" | sha256sum -c - && \
+    dnf install -y --disablerepo='*' --enablerepo=acai-f44-ga-locked checkpolicy policycoreutils && dnf clean all && \
     checkmodule -M -m -o /qemu_guest_agent_vsock.mod /qemu_guest_agent_vsock.te && \
     semodule_package -o /qemu_guest_agent_vsock.pp -m /qemu_guest_agent_vsock.mod
 
@@ -14,7 +21,7 @@
 ARG FEDORA_VERSION=${FEDORA_VERSION}
 
 RUN --mount=type=bind,source=/build_common.sh,target=/run/build_common.sh,z \
-    /run/build_common.sh && ostree container commit
+    /run/build_common.sh && rm -rf /run/* /tmp/* /var/tmp/* /var/cache/*
 
 COPY podman-iptables.conf /etc/modules-load.d/podman-iptables.conf
 
