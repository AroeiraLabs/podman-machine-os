+# ACAI P4-3A source-lock: sem repositorio dinamico (COPR/Packit); dnf preso ao
+# snapshot GA congelado, verificado NO CACHE que o dnf usa. RPMs de containers
+# chegam pre-verificados (sha256 + assinatura) em /var/tmp/rpms (verify-lock).
+rm -f /etc/yum.repos.d/*.repo
+cat > /etc/yum.repos.d/acai-f44-ga-locked.repo <<'ACAIREPO'
+[acai-f44-ga-locked]
+name=Fedora 44 GA (locked)
+baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/aarch64/os/
+enabled=1
+gpgcheck=1
+gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary
+metadata_expire=never
+ACAIREPO
+dnf makecache --refresh
+ACAI_REPOMD="$(find /var/cache -path '*acai-f44-ga-locked*' -name repomd.xml | head -1)"
+echo "ad124f8125666e9059d7a8180427bdaea80f6286f71140457e5c7edd95883eee  ${ACAI_REPOMD}" | sha256sum -c -
+shopt -s nullglob
+ACAI_RPMS=(/var/tmp/rpms/*.rpm)
+if [[ ${#ACAI_RPMS[@]} -eq 0 ]]; then echo "ACAI STOP: nenhum RPM pre-verificado em /var/tmp/rpms"; exit 42; fi
+dnf install -y --best --allowerasing --disablerepo='*' --enablerepo=acai-f44-ga-locked "${ACAI_RPMS[@]}"
 
