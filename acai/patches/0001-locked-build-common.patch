 # Patching qemu backed binfmt configurations to use the actual executable's permissions and not the interpreter's
 for x in /usr/lib/binfmt.d/*.conf; do sed 's/\(:[^C:]*\)$/\1PC/' "$x" | tee /etc/binfmt.d/"$(basename "$x")"; done
+
+# O /etc/machine-id tem de ficar AUSENTE, nao vazio. O systemd le esse
+# arquivo para decidir se e primeiro boot (src/core/main.c): so a ausencia
+# do arquivo ou o conteudo literal 'uninitialized' resultam em first_boot;
+# um arquivo VAZIO e lido como sistema ja inicializado. Sem primeiro boot o
+# PID 1 nao executa manager_preset_all(), e os presets que o Ignition grava
+# em /etc/systemd/system-preset/20-ignition.preset nunca viram symlink:
+# nenhuma unidade e habilitada, o ready.service nao roda e o host espera
+# para sempre pelo sinal de prontidao. E a mesma razao pela qual o proprio
+# Fedora CoreOS remove o arquivo em coreos-bootc-delta.yaml.
+rm -vf /etc/machine-id
+test ! -e /etc/machine-id || { echo "ACAI STOP: /etc/machine-id ainda existe"; exit 42; }
