+# ACAI P4-3A source-lock: dnf preso a dois snapshots imutaveis conferidos NO
+# CACHE que ele consome. RPMs de containers chegam pre-verificados via
+# acai/verify-lock.sh.
+rm -f /etc/yum.repos.d/*.repo
+printf '%s\n' '[acai-f44-ga-locked]' 'name=acai-f44-ga-locked' 'baseurl=https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/aarch64/os/' 'enabled=1' 'gpgcheck=1' 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary' 'metadata_expire=never' > /etc/yum.repos.d/acai-f44-ga-locked.repo
+printf '%s\n' '[acai-f44-updates-locked]' 'name=acai-f44-updates-locked' 'baseurl=https://dl.fedoraproject.org/pub/fedora/linux/updates/44/Everything/aarch64/' 'enabled=1' 'gpgcheck=1' 'gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-44-primary' 'metadata_expire=never' > /etc/yum.repos.d/acai-f44-updates-locked.repo
+dnf makecache --refresh
+echo "ad124f8125666e9059d7a8180427bdaea80f6286f71140457e5c7edd95883eee  $(find /var/cache -path '*acai-f44-ga-locked*' -name repomd.xml | head -1)" | sha256sum -c -
+echo "bd7c09a02adfa2c939e40c0c353baa8915f12918b0498ce3aa7afafbae429d56  $(find /var/cache -path '*acai-f44-updates-locked*' -name repomd.xml | head -1)" | sha256sum -c -
+shopt -s nullglob
+ACAI_RPMS=(/var/tmp/rpms/*.rpm)
+if [[ ${#ACAI_RPMS[@]} -eq 0 ]]; then echo "ACAI STOP: nenhum RPM pre-verificado"; exit 42; fi
+dnf install -y --best --allowerasing --disablerepo='*' --enablerepo=acai-f44-ga-locked,acai-f44-updates-locked "${ACAI_RPMS[@]}"
+# Kernel fora do upgrade: kernels sao installonly e o novo entraria AO LADO do
+# da base, gerando imagem com dois kernels cujo disco entra em kernel panic.
+dnf upgrade -y --disablerepo='*' --enablerepo=acai-f44-ga-locked,acai-f44-updates-locked --exclude='kernel*'
+if [[ $(rpm -q kernel | wc -l) -ne 1 ]]; then echo "ACAI STOP: imagem com mais de um kernel"; rpm -q kernel; exit 42; fi
 
